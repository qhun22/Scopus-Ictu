@startuml AUTH-ACT-02b-session
skinparam dpi 150
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ActivityBackgroundColor #D6EAF8
skinparam ActivityBorderColor #2471A3
skinparam ActivityFontSize 13
skinparam ActivityFontName "Arial"
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #D4AC0D

title AUTH-ACT-02b (3/3) -- Cap phien JWT (AS-IS)

start

-> Xac minh thanh cong\n(tu trang 2/3);

:Tao JWT HS256\n{sub, email, role, av};

:Set-Cookie: access_token\n(HttpOnly, SameSite=Lax);

:200 OK + UserResponse;

:setUser() → /home;

if (Phien het han\nhoac av thay doi?) then (Co)
  :401 SESSION_REVOKED\nForceLogout → /login;
  stop
endif

:Tiep tuc lam viec;

stop

@enduml
