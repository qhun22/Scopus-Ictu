<?xml version="1.0" encoding="UTF-8"?>
<!-- Sinh bởi docs/design/tools/gen_bpmn.py. Mở bằng https://demo.bpmn.io hoặc Camunda Modeler để chỉnh sửa. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ScopusIctu" targetNamespace="http://scopus-ictu/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Hệ thống Scopus–ICTU" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Quy trình nghiệp vụ thực tế" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_adm" name="ADMIN&#10;(Quản trị viên)">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Hệ thống&#10;(API/dịch vụ — tự động)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cli" name="Kỹ thuật viên&#10;(script CLI)">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_rev" name="REVIEWER / ADMIN&#10;(người duyệt)">
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_lec" name="LECTURER&#10;(Giảng viên)">
        <bpmn:flowNodeRef>L1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Có dữ liệu nguồn&#10;(CSV Scopus / JSON GV)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A1" name="Tải tệp lên&#10;(UC-08 JSON / UC-10 CSV)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S1" name="Kiểm tra tệp: định dạng,&#10;cột EID, SHA-256 trùng,&#10;lỗi từng dòng; JSON: xem trước">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Hợp lệ&#10;và không trùng?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="AE" name="Đọc lỗi theo dòng:&#10;sửa tệp hoặc xác nhận&#10;nhập trùng">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S2" name="Lưu dữ liệu THÔ: JSON →&#10;lecturers + snapshot;&#10;CSV → scopus_imports,&#10;raw_scopus_records; audit">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Là CSV&#10;Scopus?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Hồ sơ giảng viên&#10;đã lưu">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A3" name="Chạy chuẩn hóa công bố&#10;và bóc tách tác giả&#10;(UC-11, UC-12)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S3" name="Chuẩn hóa: EID chống trùng&#10;→ công bố + nguồn gốc;&#10;tác giả + vị trí tác giả">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="C1" name="Nạp bằng chứng ngoài:&#10;công bố đã biết (Craw),&#10;đơn vị (OpenAlex/Crossref)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="C2" name="Sinh ứng viên: 4 luật tên&#10;+ bằng chứng công bố;&#10;lưu PENDING, idempotent">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="R1" name="Xem hàng đợi và&#10;bằng chứng ứng viên&#10;(UC-17)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Quyết định&#10;của người duyệt?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EP" name="Giữ PENDING&#10;(không ghi gì)">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S4" name="Kiểm tra: ứng viên PENDING,&#10;phiên bản hiện hành,&#10;Scopus ID chưa APPROVED">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S6" name="Kiểm tra lý do bắt buộc;&#10;ghi review REJECT&#10;+ audit">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Hợp lệ?">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ER" name="Dừng: HTTP 409&#10;(xung đột/dữ liệu cũ)">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_1" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="S5" name="Ghi review ACCEPT,&#10;danh tính APPROVED,&#10;bằng chứng danh tính, audit">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GP" name="">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="R2" name="Truy vết: xem lịch sử&#10;review, nhật ký&#10;(UC-19, UC-07)">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="L1" name="Xem liên kết Scopus&#10;và công bố của tôi&#10;(UC-21, UC-22)">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E2" name="Đã truy vết">
      <bpmn:incoming>f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E3" name="Giảng viên&#10;khai thác kết quả">
      <bpmn:incoming>f26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S0" targetRef="A1" />
    <bpmn:sequenceFlow id="f2" sourceRef="A1" targetRef="S1" />
    <bpmn:sequenceFlow id="f3" sourceRef="S1" targetRef="G1" />
    <bpmn:sequenceFlow id="f4" name="Không" sourceRef="G1" targetRef="AE" />
    <bpmn:sequenceFlow id="f5" name="Làm lại" sourceRef="AE" targetRef="A1" />
    <bpmn:sequenceFlow id="f6" name="Có" sourceRef="G1" targetRef="S2" />
    <bpmn:sequenceFlow id="f7" sourceRef="S2" targetRef="G2" />
    <bpmn:sequenceFlow id="f8" name="CSV" sourceRef="G2" targetRef="A3" />
    <bpmn:sequenceFlow id="f9" name="JSON" sourceRef="G2" targetRef="E1" />
    <bpmn:sequenceFlow id="f10" sourceRef="A3" targetRef="S3" />
    <bpmn:sequenceFlow id="f11" sourceRef="S3" targetRef="C1" />
    <bpmn:sequenceFlow id="f12" sourceRef="C1" targetRef="C2" />
    <bpmn:sequenceFlow id="f13" sourceRef="C2" targetRef="R1" />
    <bpmn:sequenceFlow id="f14" sourceRef="R1" targetRef="G3" />
    <bpmn:sequenceFlow id="f15" name="ACCEPT" sourceRef="G3" targetRef="S4" />
    <bpmn:sequenceFlow id="f16" name="REJECT (lý do bắt buộc)" sourceRef="G3" targetRef="S6" />
    <bpmn:sequenceFlow id="f17" name="Giữ PENDING" sourceRef="G3" targetRef="EP" />
    <bpmn:sequenceFlow id="f18" sourceRef="S4" targetRef="G4" />
    <bpmn:sequenceFlow id="f19" name="Có" sourceRef="G4" targetRef="S5" />
    <bpmn:sequenceFlow id="f20" name="Không" sourceRef="G4" targetRef="ER" />
    <bpmn:sequenceFlow id="f21" sourceRef="S5" targetRef="GP" />
    <bpmn:sequenceFlow id="f22" sourceRef="GP" targetRef="R2" />
    <bpmn:sequenceFlow id="f23" sourceRef="GP" targetRef="L1" />
    <bpmn:sequenceFlow id="f24" sourceRef="S6" targetRef="R2" />
    <bpmn:sequenceFlow id="f25" sourceRef="R2" targetRef="E2" />
    <bpmn:sequenceFlow id="f26" sourceRef="L1" targetRef="E3" />
    <bpmn:textAnnotation id="T1"><bpmn:text>Dữ liệu thô bất biến: raw_scopus_records.raw_payload và lecturer_source_snapshots không bị sửa khi chuẩn hóa.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_T1" sourceRef="S2" targetRef="T1" />
    <bpmn:textAnnotation id="T2"><bpmn:text>KHÔNG có bước tự động phê duyệt: hệ thống chỉ ĐỀ XUẤT ứng viên; danh tính APPROVED chỉ được tạo sau ACCEPT của người (ADR-004, test_no_mapping_review_written).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_T2" sourceRef="C2" targetRef="T2" />
  </bpmn:process>
