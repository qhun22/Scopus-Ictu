@startuml ERD-E_don_vi_cong_tac
' Nguồn: docs/design/database/source/schema_snapshot.json (sinh bởi tools/gen_database_assets.py) — KHÔNG sửa tay phần sinh tự động.
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  FontSize 12
  AttributeFontSize 11
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10
skinparam packageStyle rectangle
hide circle
title ERD-E — Cụm E: Đơn vị công tác theo tác giả (affiliation)

entity "organizations" as organizations #FADBD8 {
  *id : uuid <<PK>>
  --
  *source_system : varchar(50)
  source_org_id : text
  ror : text
  *display_name : text
  country_code : varchar(2)
  *created_at : timestamptz
}

entity "publication_author_affiliation_resolutions" as publication_author_affiliation_resolutions #FADBD8 {
  *id : uuid <<PK>>
  --
  *publication_author_id : uuid <<FK>>
  *source_system : varchar(50)
  *source_payload_sha256 : varchar(64)
  *link_status : varchar(20)
  link_method : varchar(40)
  unresolved_reason : varchar(80)
  affiliation_presence : varchar(10)
  *evidence : jsonb
  source_doi : text
  source_work_id : text
  external_position : integer
  external_author_name : text
  external_author_orcid : varchar(19)
  retrieved_at : timestamptz
  *importer_version : varchar(40)
  *created_at : timestamptz
}

entity "publication_author_affiliations" as publication_author_affiliations #FADBD8 {
  *id : uuid <<PK>>
  --
  *resolution_id : uuid <<FK>>
  *link_status : varchar(20) <<FK>>
  *ord : integer
  raw_index : integer
  raw_affiliation_text : text
  organization_id : uuid <<FK>>
  *created_at : timestamptz
}

entity "publication_authors" as publication_authors #EEEEEE {
  *id : uuid <<PK>>
  ..
  (bảng thuộc cụm D)
}

publication_authors ||--o{ publication_author_affiliation_resolutions : publication_author_id
organizations |o--o{ publication_author_affiliations : organization_id
publication_author_affiliation_resolutions ||--o{ publication_author_affiliations : resolution_id, link_status
legend bottom right
  <b>Chú giải</b>
  * = NOT NULL · <<PK>> khóa chính · <<FK>> khóa ngoại · <<UQ>> duy nhất
  Đầu nối (crow's foot): hai gạch = đúng 1 · vòng tròn + gạch = 0..1 · vòng tròn + chân chim = 0..*
  Nhãn trên đường nối = cột khóa ngoại ở bảng con
  Nguồn: PostgreSQL thật (alembic a9c2e4f71b30)
endlegend

@enduml
