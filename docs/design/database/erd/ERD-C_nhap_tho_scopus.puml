@startuml ERD-C_nhap_tho_scopus
' Nguồn: docs/design/database/source/schema_snapshot.json (sinh bởi tools/gen_database_assets.py) — KHÔNG sửa tay phần sinh tự động.
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  FontSize 12
  AttributeFontSize 11
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10
skinparam packageStyle rectangle
hide circle
title ERD-C — Cụm C: Nhập dữ liệu thô Scopus

entity "scopus_imports" as scopus_imports #D5F5E3 {
  *id : uuid <<PK>>
  --
  *file_name : varchar(255)
  *file_sha256 : varchar(64)
  *total_records : integer
  *valid_records : integer
  *invalid_records : integer
  *status : varchar(20)
  error_summary : jsonb
  *version : integer
  *created_at : timestamptz
  *updated_at : timestamptz
  normalization_summary : jsonb
}

entity "raw_scopus_records" as raw_scopus_records #D5F5E3 {
  *id : uuid <<PK>>
  --
  *import_id : uuid <<FK>>
  *row_number : integer
  *row_hash : varchar(64)
  eid_raw : text
  doi_raw : text
  *raw_payload : jsonb
  *validation_status : varchar(20)
  validation_errors : jsonb
  *created_at : timestamptz
}

entity "publication_raw_sources" as publication_raw_sources #EEEEEE {
  *id : uuid <<PK>>
  ..
  (bảng thuộc cụm D)
}

entity "scopus_author_name_variants" as scopus_author_name_variants #EEEEEE {
  *id : uuid <<PK>>
  ..
  (bảng thuộc cụm D)
}

raw_scopus_records ||--o| publication_raw_sources : raw_record_id
scopus_imports ||--o{ raw_scopus_records : import_id
raw_scopus_records ||--o{ scopus_author_name_variants : first_seen_raw_record_id
legend bottom right
  <b>Chú giải</b>
  * = NOT NULL · <<PK>> khóa chính · <<FK>> khóa ngoại · <<UQ>> duy nhất
  Đầu nối (crow's foot): hai gạch = đúng 1 · vòng tròn + gạch = 0..1 · vòng tròn + chân chim = 0..*
  Nhãn trên đường nối = cột khóa ngoại ở bảng con
  Nguồn: PostgreSQL thật (alembic a9c2e4f71b30)
endlegend

@enduml
