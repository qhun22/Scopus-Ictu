@startuml UCD-0A-P6b-g5
' UCD-0A Trang 6 — Nhóm 5: Tìm kiếm, Thống kê và Xuất dữ liệu (4 UC)
left to right direction
skinparam dpi 150
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.5
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2471A3
  FontSize 13
  FontName "Arial"
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B7770D
  FontSize 13
  FontName "Arial"
}
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor #2471A3
  FontSize 13
  FontStyle bold
  FontName "Arial"
}

title UCD-0A (6/6) -- Nhom 5: Tim kiem, Thong ke va Xuat du lieu

actor "Quản trị viên\n(ADMIN)" as ADMIN

rectangle "Nhóm 5 — Tìm kiếm, Thống kê và Xuất dữ liệu" {
  usecase "UC-14\nTra cứu tổng hợp\n(giảng viên, công bố,\ntác giả)" as UC14
  usecase "UC-04\nXem thống kê\ntổng quan (dashboard)\n[một phần]" as UC04
  usecase "UC-15\nXuất dữ liệu\ncông bố ra JSON" as UC15
  usecase "UC-09\nXuất hồ sơ\ngiảng viên ra JSON" as UC09
}

ADMIN --> UC14
ADMIN --> UC04
ADMIN --> UC15
ADMIN --> UC09

legend bottom
  [một phần] = triển khai chưa đầy đủ
  --> Actor đến UC: quyền truy cập RBAC đã kiểm tra
endlegend

@enduml
