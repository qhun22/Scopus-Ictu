@startuml UCD-0A-P3-g1
' UCD-0A Trang 3 — Nhóm 1: Nhập dữ liệu (4 UC + 2 quan hệ extend)
' A4 dọc. Font 13pt @ dpi 150.
left to right direction
skinparam dpi 150
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.5
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2471A3
  FontSize 13
  FontName "Arial"
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B7770D
  FontSize 13
  FontName "Arial"
}
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor #2471A3
  FontSize 13
  FontStyle bold
  FontName "Arial"
}

title UCD-0A (3/6) -- Nhom 1: Nhap du lieu

actor "Quản trị viên\n(ADMIN)" as ADMIN

rectangle "Nhóm 1 — Nhập dữ liệu" {
  usecase "UC-08\nNhập hồ sơ giảng viên\ntừ JSON\n(kiểm tra, xem trước, nhập)" as UC08
  usecase "UC-08a\nHoàn tác đợt nhập\nhồ sơ giảng viên" as UC08a
  usecase "UC-10\nNhập tệp CSV Scopus\n(cấu hình, xem trước, nhập)" as UC10
  usecase "UC-10a\nQuản lý đợt nhập CSV\n(hủy, lưu trữ, khôi phục, xóa)" as UC10a
}

ADMIN --> UC08
ADMIN --> UC08a
ADMIN --> UC10
ADMIN --> UC10a

UC08a .> UC08 : <<extend>>
UC10a .> UC10 : <<extend>>

legend bottom
  <<extend>> = UC08a/UC10a mở rộng UC08/UC10 khi thực thi
  --> Actor đến UC: quyền truy cập RBAC đã kiểm tra
endlegend

@enduml
