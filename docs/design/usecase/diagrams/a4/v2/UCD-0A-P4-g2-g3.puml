@startuml UCD-0A-P4-g2-g3
' UCD-0A Trang 4 — Nhóm 2: Quản lý hồ sơ (4 UC) + Nhóm 3: Công bố (1 UC)
' 5 UC tổng. A4 dọc. Font 13pt @ dpi 150.
left to right direction
skinparam dpi 150
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.5
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2471A3
  FontSize 13
  FontName "Arial"
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B7770D
  FontSize 13
  FontName "Arial"
}
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor #2471A3
  FontSize 13
  FontStyle bold
  FontName "Arial"
}

title UCD-0A (4/6) -- Nhom 2: Quan ly ho so va Nhom 3: Quan ly cong bo

actor "Quản trị viên\n(ADMIN)" as ADMIN

rectangle "Nhóm 2 — Quản lý hồ sơ tác giả / giảng viên" {
  usecase "UC-05\nQuản lý hồ sơ\ngiảng viên" as UC05
  usecase "UC-06\nQuản lý tài khoản\nvà phân quyền" as UC06
  usecase "UC-16\nXem tác giả Scopus\n(danh sách, thống kê)\n[một phần]" as UC16
  usecase "UC-23\nXem hồ sơ/danh tính/\ncông bố Scopus\ncủa một giảng viên [API]" as UC23
}

rectangle "Nhóm 3 — Quản lý công bố" {
  usecase "UC-13\nXem danh sách và\nchi tiết công bố\n(kèm đơn vị tác giả)" as UC13
}

ADMIN --> UC05
ADMIN --> UC06
ADMIN --> UC16
ADMIN --> UC23
ADMIN --> UC13

legend bottom
  [một phần] = triển khai chưa đầy đủ
  [API] = chỉ có API, chưa có giao diện người dùng
  --> Actor đến UC: quyền truy cập RBAC đã kiểm tra
endlegend

@enduml
