@startuml UCD-0C_tong_the_lecturer
' Nguồn: docs/design/usecase/usecase_map.json (sinh bởi tools/gen_usecase_assets.py). Không sửa tay phần sinh tự động.
left to right direction
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2F8
  BorderColor #1F618D
  FontSize 12
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B9770E
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10

title UCD-0C — Use Case tổng thể của Giảng viên (LECTURER): 6 UC

actor "Giảng viên\n(LECTURER)" as LECTURER

rectangle "Xác thực, thông báo và giám sát" {
  usecase "UC-01\nĐăng nhập" as UC01
  usecase "UC-02\nĐăng xuất và kiểm tra\nphiên" as UC02
  usecase "UC-03\nNhận thông báo tài khoản\n[một phần]" as UC03
}
rectangle "Nhóm 2 — Quản lý hồ sơ tác giả/giảng viên" {
  usecase "UC-20\nXem hồ sơ cá nhân" as UC20
  usecase "UC-21\nXem liên kết Scopus đã\nduyệt của tôi" as UC21
}
rectangle "Nhóm 3 — Quản lý công bố" {
  usecase "UC-22\nXem công bố của tôi (từ\ndanh tính APPROVED)" as UC22
}

LECTURER --> UC01
LECTURER --> UC02
LECTURER --> UC03
LECTURER --> UC20
LECTURER --> UC21
LECTURER --> UC22
legend bottom right
  <b>Chú giải</b>
  Oval = use case có thật trong mã (ID khớp UC_INVENTORY.md)
  [CLI] chạy bằng script · [API] chỉ có API, chưa có giao diện · [một phần] triển khai chưa đầy đủ
  Đường nét liền actor—UC = quyền truy cập đã đối chiếu với require_role (RBAC_API_MATRIX)
endlegend

@enduml
