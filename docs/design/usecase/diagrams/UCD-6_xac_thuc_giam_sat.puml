@startuml UCD-6_xac_thuc_giam_sat
' Nguồn: docs/design/usecase/usecase_map.json (sinh bởi tools/gen_usecase_assets.py). Không sửa tay phần sinh tự động.
left to right direction
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2F8
  BorderColor #1F618D
  FontSize 12
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B9770E
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10

title UCD-6 — Xác thực, thông báo, giám sát và khởi tạo

actor "Quản trị viên\n(ADMIN)" as ADMIN
actor "Phê duyệt viên\n(REVIEWER)" as REVIEWER
actor "Giảng viên\n(LECTURER)" as LECTURER
actor "Kỹ thuật viên\n«CLI — không phải vai trò»" as TECH <<CLI>>

rectangle "Xác thực, thông báo và giám sát" {
  usecase "UC-01\nĐăng nhập" as UC01
  usecase "UC-02\nĐăng xuất và kiểm tra\nphiên" as UC02
  usecase "UC-03\nNhận thông báo tài khoản\n[một phần]" as UC03
  usecase "UC-07\nXem nhật ký kiểm toán" as UC07
  usecase "UC-26\nKhởi tạo dữ liệu và tài\nkhoản ADMIN demo\n[CLI]" as UC26
}

ADMIN --> UC01
REVIEWER --> UC01
LECTURER --> UC01
ADMIN --> UC02
REVIEWER --> UC02
LECTURER --> UC02
ADMIN --> UC03
REVIEWER --> UC03
LECTURER --> UC03
ADMIN --> UC07
TECH --> UC26
legend bottom right
  <b>Chú giải</b>
  Oval = use case có thật trong mã (ID khớp UC_INVENTORY.md)
  [CLI] chạy bằng script · [API] chỉ có API, chưa có giao diện · [một phần] triển khai chưa đầy đủ
  Đường nét liền actor—UC = quyền truy cập đã đối chiếu với require_role (RBAC_API_MATRIX)
endlegend

@enduml
