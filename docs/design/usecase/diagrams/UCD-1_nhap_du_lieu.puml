@startuml UCD-1_nhap_du_lieu
' Nguồn: docs/design/usecase/usecase_map.json (sinh bởi tools/gen_usecase_assets.py). Không sửa tay phần sinh tự động.
left to right direction
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2F8
  BorderColor #1F618D
  FontSize 12
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B9770E
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10

title UCD-1 — Nhóm 1: Nhập dữ liệu

actor "Quản trị viên\n(ADMIN)" as ADMIN
actor "Kỹ thuật viên\n«CLI — không phải vai trò»" as TECH <<CLI>>

rectangle "Nhóm 1 — Nhập dữ liệu" {
  usecase "UC-08\nNhập hồ sơ giảng viên từ\nJSON (kiểm tra, xem trước,\nnhập)" as UC08
  usecase "UC-08a\nHoàn tác đợt nhập hồ sơ\ngiảng viên" as UC08a
  usecase "UC-10\nNhập tệp CSV Scopus" as UC10
  usecase "UC-10a\nQuản lý đợt nhập CSV (hủy,\nlưu trữ, khôi phục lịch\nsử, xóa)" as UC10a
  usecase "UC-25\nNạp công bố đã biết (Craw)\nvà đơn vị công tác ngoài\n(OpenAlex/Crossref)\n[CLI]" as UC25
}

ADMIN --> UC08
ADMIN --> UC08a
ADMIN --> UC10
ADMIN --> UC10a
TECH --> UC25
UC08a .> UC08 : <<extend>>
UC10a .> UC10 : <<extend>>
legend bottom right
  <b>Chú giải</b>
  Oval = use case có thật trong mã (ID khớp UC_INVENTORY.md)
  [CLI] chạy bằng script · [API] chỉ có API, chưa có giao diện · [một phần] triển khai chưa đầy đủ
  Đường nét liền actor—UC = quyền truy cập đã đối chiếu với require_role (RBAC_API_MATRIX)
  «extend» = hành vi tùy chọn trên đợt nhập đã có (hoàn tác/hủy/lưu trữ/xóa).
endlegend

@enduml
