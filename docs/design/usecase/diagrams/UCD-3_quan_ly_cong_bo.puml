@startuml UCD-3_quan_ly_cong_bo
' Nguồn: docs/design/usecase/usecase_map.json (sinh bởi tools/gen_usecase_assets.py). Không sửa tay phần sinh tự động.
left to right direction
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2F8
  BorderColor #1F618D
  FontSize 12
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B9770E
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10

title UCD-3 — Nhóm 3: Quản lý công bố

actor "Quản trị viên\n(ADMIN)" as ADMIN
actor "Phê duyệt viên\n(REVIEWER)" as REVIEWER
actor "Giảng viên\n(LECTURER)" as LECTURER

rectangle "Nhóm 3 — Quản lý công bố" {
  usecase "UC-13\nXem danh sách và chi tiết\ncông bố (kèm đơn vị theo\ntác giả, nguồn gốc dòng\nCSV)" as UC13
  usecase "UC-22\nXem công bố của tôi (từ\ndanh tính APPROVED)" as UC22
}

ADMIN --> UC13
REVIEWER --> UC13
LECTURER --> UC22
legend bottom right
  <b>Chú giải</b>
  Oval = use case có thật trong mã (ID khớp UC_INVENTORY.md)
  [CLI] chạy bằng script · [API] chỉ có API, chưa có giao diện · [một phần] triển khai chưa đầy đủ
  Đường nét liền actor—UC = quyền truy cập đã đối chiếu với require_role (RBAC_API_MATRIX)
endlegend

@enduml
