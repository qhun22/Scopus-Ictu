@startuml UCD-0A_tong_the_admin
' Nguồn: docs/design/usecase/usecase_map.json (sinh bởi tools/gen_usecase_assets.py). Không sửa tay phần sinh tự động.
left to right direction
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2F8
  BorderColor #1F618D
  FontSize 12
}
skinparam actor {
  BackgroundColor #FDEBD0
  BorderColor #B9770E
}
skinparam ArrowColor #34495E
skinparam ArrowFontSize 10

title UCD-0A — Use Case tổng thể của Quản trị viên (ADMIN): 22 UC

actor "Quản trị viên\n(ADMIN)" as ADMIN

rectangle "Xác thực, thông báo và giám sát" {
  usecase "UC-01\nĐăng nhập" as UC01
  usecase "UC-02\nĐăng xuất và kiểm tra\nphiên" as UC02
  usecase "UC-03\nNhận thông báo tài khoản\n[một phần]" as UC03
  usecase "UC-07\nXem nhật ký kiểm toán" as UC07
}
rectangle "Nhóm 1 — Nhập dữ liệu" {
  usecase "UC-08\nNhập hồ sơ giảng viên từ\nJSON (kiểm tra, xem trước,\nnhập)" as UC08
  usecase "UC-08a\nHoàn tác đợt nhập hồ sơ\ngiảng viên" as UC08a
  usecase "UC-10\nNhập tệp CSV Scopus" as UC10
  usecase "UC-10a\nQuản lý đợt nhập CSV (hủy,\nlưu trữ, khôi phục lịch\nsử, xóa)" as UC10a
}
rectangle "Nhóm 2 — Quản lý hồ sơ tác giả/giảng viên" {
  usecase "UC-05\nQuản lý hồ sơ giảng viên" as UC05
  usecase "UC-06\nQuản lý tài khoản và phân\nquyền" as UC06
  usecase "UC-16\nXem tác giả Scopus (danh\nsách, thống kê, chi tiết)\n[một phần]" as UC16
  usecase "UC-23\nQuản trị xem hồ sơ/danh\ntính/công bố Scopus của\nmột giảng viên\n[API]" as UC23
}
rectangle "Nhóm 3 — Quản lý công bố" {
  usecase "UC-13\nXem danh sách và chi tiết\ncông bố (kèm đơn vị theo\ntác giả, nguồn gốc dòng\nCSV)" as UC13
}
rectangle "Nhóm 4 — Chuẩn hóa, đối soát và phê duyệt" {
  usecase "UC-11\nChuẩn hóa công bố từ bản\nghi thô" as UC11
  usecase "UC-12\nBóc tách tác giả Scopus" as UC12
  usecase "UC-17\nXem hàng đợi ứng viên và\nbằng chứng" as UC17
  usecase "UC-18\nDuyệt ứng viên (ACCEPT /\nREJECT)" as UC18
  usecase "UC-19\nXem lịch sử review" as UC19
}
rectangle "Nhóm 5 — Tìm kiếm, thống kê và xuất dữ liệu" {
  usecase "UC-14\nTra cứu tổng hợp (giảng\nviên, công bố, tác giả)" as UC14
  usecase "UC-04\nXem thống kê tổng quan\n(dashboard)\n[một phần]" as UC04
  usecase "UC-15\nXuất dữ liệu công bố ra\nJSON" as UC15
  usecase "UC-09\nXuất hồ sơ giảng viên ra\nJSON" as UC09
}

ADMIN --> UC01
ADMIN --> UC02
ADMIN --> UC03
ADMIN --> UC07
