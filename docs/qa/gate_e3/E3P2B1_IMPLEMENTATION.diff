index 0000000..1a9d60e
--- /dev/null
+++ b/backend/app/services/source_claims/provenance.py
@@ -0,0 +1,117 @@
+"""Bind harvest file bytes to the harvest's own manifest and semantic replay (Gate E.3 / P2-B1).
+
+Pure: the caller reads the files and passes their exact bytes. ``adapters.profiles_artifact``
+trusts the objects it is given; P2-B2 must pass it only objects returned by
+``bind_harvest_files``, so that the lecturers list provably came from the bytes whose SHA-256 is
+recorded and from the harvest that the manifest and replay describe. A self-consistent manifest
+and replay prove nothing about arbitrary caller input on their own.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections import Counter
+from dataclasses import dataclass
+from typing import Any
+
+# Craw ``ictu_harvester.full_harvest.semantic_hash``: keys dropped at every level before hashing.
+HARVEST_VOLATILE_KEYS = frozenset({"retrieved_at", "harvest_started_at", "harvest_completed_at",
+                                   "last_attempt_time"})
+MANIFEST_NAME = "harvest_manifest.json"
+
+
+class ProvenanceError(ValueError):
+    def __init__(self, code: str, message: str) -> None:
+        super().__init__(f"{code}: {message}")
+        self.code = code
+
+
+@dataclass(frozen=True, slots=True)
+class HarvestBinding:
+    lecturers: Any
+    manifest: dict
+    semantic_replay: dict
+    crawl_report: dict | None
+    lecturers_sha256: str
+    lecturers_semantic_sha256: str
+    manifest_semantic_sha256: str
+
+
+def _without_volatile(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {k: _without_volatile(v) for k, v in value.items() if k not in HARVEST_VOLATILE_KEYS}
+    if isinstance(value, list):
+        return [_without_volatile(v) for v in value]
+    return value
+
+
+def harvest_semantic_hash(value: Any) -> str:
+    """Reproduces the harvester's semantic hash (sorted, compact, non-ASCII kept)."""
+    encoded = json.dumps(_without_volatile(value), ensure_ascii=False, sort_keys=True,
+                         separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _decode(data: bytes, name: str) -> Any:
+    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+        duplicated = sorted(k for k, n in Counter(k for k, _ in pairs).items() if n > 1)
+        if duplicated:
+            raise ProvenanceError("DUPLICATE_JSON_KEY", f"{name}: duplicate keys {duplicated}")
+        return dict(pairs)
+
+    if not isinstance(data, bytes):
+        raise ProvenanceError("BYTES_REQUIRED", f"{name} must be passed as the exact file bytes")
+    try:
+        return json.loads(data.decode("utf-8"), object_pairs_hook=reject_duplicates)
+    except UnicodeDecodeError as exc:
+        raise ProvenanceError("NOT_UTF8", name) from exc
+    except json.JSONDecodeError as exc:
+        raise ProvenanceError("NOT_JSON", f"{name}: {exc}") from exc
+
+
+def bind_harvest_files(
+    *, lecturers_bytes: bytes, lecturers_sha256: str, manifest_bytes: bytes, replay_bytes: bytes,
+    crawl_report_bytes: bytes | None = None, upstream_name: str = "lecturers.json",
+) -> HarvestBinding:
+    """Decode the harvest files from their bytes and prove they belong together.
+
+    Raises ``ProvenanceError`` unless: the lecturers bytes hash to ``lecturers_sha256``; their
+    semantic hash equals the manifest's; every replay pass passed and recorded both that hash and
+    the manifest's own semantic hash; and the crawl report, when given, matches the manifest.
+    """
+    lecturers = _decode(lecturers_bytes, upstream_name)
+    if hashlib.sha256(lecturers_bytes).hexdigest() != lecturers_sha256:
+        raise ProvenanceError("BYTES_SHA256_MISMATCH",
+                              f"{upstream_name} bytes do not hash to the declared SHA-256")
+    manifest = _decode(manifest_bytes, MANIFEST_NAME)
+    replay = _decode(replay_bytes, "semantic_replay.json")
+    if not isinstance(manifest, dict) or not isinstance(replay, dict):
+        raise ProvenanceError("NOT_OBJECT", "manifest and semantic replay must be JSON objects")
+
+    lecturers_semantic = harvest_semantic_hash(lecturers)
+    recorded = (manifest.get("semantic_file_hashes") or {}).get(upstream_name)
+    if recorded != lecturers_semantic:
+        raise ProvenanceError("MANIFEST_HASH_MISMATCH",
+                              f"{upstream_name} is not the file this manifest describes")
+
+    manifest_semantic = harvest_semantic_hash(manifest)
+    passes = replay.get("file_hashes")
+    if replay.get("a_equals_b_equals_c") is not True or not isinstance(passes, dict) or not passes:
+        raise ProvenanceError("REPLAY_NOT_PASSED", "semantic replay did not pass")
+    for name, run in passes.items():
+        if not isinstance(run, dict) or run.get(upstream_name) != lecturers_semantic \
+                or run.get(MANIFEST_NAME) != manifest_semantic:
+            raise ProvenanceError("REPLAY_HASH_MISMATCH",
+                                  f"replay pass {name} does not describe these files")
+
+    crawl_report = None
+    if crawl_report_bytes is not None:
+        crawl_report = _decode(crawl_report_bytes, "crawl_report.json")
+        expected = (manifest.get("semantic_file_hashes") or {}).get("crawl_report.json")
+        if harvest_semantic_hash(crawl_report) != expected:
+            raise ProvenanceError("MANIFEST_HASH_MISMATCH",
+                                  "crawl_report.json is not the report this manifest describes")
+
+    return HarvestBinding(lecturers, manifest, replay, crawl_report, lecturers_sha256,
+                          lecturers_semantic, manifest_semantic)
diff --git b/backend/tests/unit/test_source_claims_provenance.py b/backend/tests/unit/test_source_claims_provenance.py
new file mode 100644
index 0000000..a9cd5ab
--- /dev/null
+++ b/backend/tests/unit/test_source_claims_provenance.py
@@ -0,0 +1,180 @@
+"""Gate E.3 / P2-B1 — input-file trust boundary for the future P2-B2 file reader.
+
+Synthetic harvest bundles only. The adapter trusts the objects it is given; these tests pin the
+binding P2-B2 must perform first: exact bytes ↔ declared SHA-256 ↔ manifest ↔ semantic replay.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from app.services.source_claims import adapters
+from app.services.source_claims.provenance import (
+    MANIFEST_NAME,
+    ProvenanceError,
+    bind_harvest_files,
+    harvest_semantic_hash,
+)
+
+BACKEND = Path(__file__).resolve().parents[2]
+REPO = "https://repository.example.invalid"
+
+
+def _lecturer(n, retrieved="2026-10-03T18:44:10Z"):
+    url = f"{REPO}/giang-vien/synthetic-{n}/"
+    return {"source_id": url, "full_name": f"Synthetic {n}",
+            "institutional_email": f"l{n}@example.invalid", "orcid": None,
+            "provenance": {"source_url": url, "retrieved_at": retrieved}}
+
+
+def _encode(value) -> bytes:
+    return (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
+
+
+def bundle(lecturers=None, *, replay_ok=True):
+    """Files as the harvester writes them: manifest and replay carry semantic hashes."""
+    lecturers = lecturers if lecturers is not None else [_lecturer(1), _lecturer(2)]
+    crawl = {"source_entity_failures": [], "duplicate_profile_url_count": 0}
+    manifest = {"harvest_started_at": "2026-10-03T20:05:14Z",
+                "harvest_completed_at": "2026-10-03T21:31:10Z", "source_base_url": REPO,
+                "source_card_count": len(lecturers), "lecturer_count": len(lecturers),
+                "status": "COMPLETE", "source_drift_detected": False,
+                "semantic_file_hashes": {"lecturers.json": harvest_semantic_hash(lecturers),
+                                         "crawl_report.json": harvest_semantic_hash(crawl)}}
+    passes = {run: {"lecturers.json": harvest_semantic_hash(lecturers),
+                    MANIFEST_NAME: harvest_semantic_hash(manifest)}
+              for run in ("A_cached_write", "B_cached_replay", "C_offline_replay")}
+    replay = {"a_equals_b_equals_c": replay_ok, "file_hashes": passes, "combined_hash": "e" * 64}
+    files = {"lecturers": _encode(lecturers), "manifest": _encode(manifest),
+             "replay": _encode(replay), "crawl": _encode(crawl)}
+    files["sha"] = hashlib.sha256(files["lecturers"]).hexdigest()
+    return files
+
+
+def bind(files, **overrides):
+    args = {"lecturers_bytes": files["lecturers"], "lecturers_sha256": files["sha"],
+            "manifest_bytes": files["manifest"], "replay_bytes": files["replay"],
+            "crawl_report_bytes": files["crawl"]}
+    args.update(overrides)
+    return bind_harvest_files(**args)
+
+
+def _code(call) -> str:
+    with pytest.raises(ProvenanceError) as raised:
+        call()
+    return raised.value.code
+
+
+def test_consistent_harvest_files_bind_and_feed_the_adapter():
+    files = bundle()
+    binding = bind(files)
+    assert binding.lecturers == json.loads(files["lecturers"])
+    assert binding.lecturers_sha256 == files["sha"]
+    artifact = adapters.profiles_artifact(
+        binding.lecturers, binding.manifest, binding.crawl_report, binding.semantic_replay,
+        lecturers_sha256=binding.lecturers_sha256)
+    assert artifact["capture"]["completeness"] == "COMPLETE"
