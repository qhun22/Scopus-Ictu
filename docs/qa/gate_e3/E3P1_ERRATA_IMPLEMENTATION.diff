+def test_r3_schema_version_pattern_matches_parser_logic():
+    import re as _re
+    schema = json.loads(SCHEMA.read_text(encoding="utf-8"))
+    schema_pattern = schema["properties"]["contract_version"]["pattern"]
+    for valid in ("1.0", "1.1", "1.99", "1.00"):
+        assert _re.match(schema_pattern, valid), f"{valid!r} should match schema pattern"
+    for invalid in ("1.x", "1.0.1", "1", "2.0", "0.9", "1."):
+        assert not _re.match(schema_pattern, invalid), f"{invalid!r} should not match"
+    # Confirm parser and schema agree
+    assert schema_pattern == r"^1\.[0-9]+$"
