+    bad_profile = {"full_name": "Test Lecturer", "email": "x@example.invalid",
+                   "source_id": bad_url}
+    snap = parse_artifact(profiles(bad_profile))
+    record, = snap.records
+    assert "SOURCE_URL_MALFORMED" in codes(record)
