+        "import sys; sys.path.insert(0, '.');"
+        "import app.services.source_claims.parser, app.services.source_claims.analysis;"
+        "bad = ('sqlalchemy', 'psycopg2', 'fastapi', 'pydantic_settings', 'app.main',"
+        " 'app.core', 'app.models', 'app.api', 'requests', 'httpx', 'urllib.request',"
+        " 'http.client', 'socket');"
+        "print(sorted(m for m in sys.modules if any(m == b or m.startswith(b + '.') for b in bad)))"
+    )
+    result = subprocess.run([sys.executable, "-I", "-c", code], cwd=BACKEND,
+                            capture_output=True, text=True, timeout=60, check=True)
+    assert result.stdout.strip() == "[]", result.stdout + result.stderr
