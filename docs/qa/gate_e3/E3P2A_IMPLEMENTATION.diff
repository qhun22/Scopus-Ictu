+HEADER = ["Tên trên Scopus", "Scopus ID", "Số bài"]
+HEADINGS = {"1": "Scopus ID nhập nhằng cần xác nhận chủ sở hữu — synthetic section",
+            "2": "Scopus ID chưa xác định chủ sở hữu thuộc ICTU — synthetic section"}
