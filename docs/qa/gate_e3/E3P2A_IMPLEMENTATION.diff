+def harvest(items, cards=None, *, crawl=None, **manifest_kwargs):
+    cards = len(items) if cards is None else cards
+    return adapters.profiles_artifact(items, manifest(cards, **manifest_kwargs),
+                                      report("master_thesis") if crawl is None else crawl,
+                                      lecturers_sha256=SHA)
