# Database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scopus_ictu
DB_DRIVER=postgresql+psycopg2

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=local

# Google Sign-In (OAuth 2.0). Optional — leave blank to keep the feature disabled.
# Create the client at https://console.cloud.google.com/apis/credentials ("OAuth client ID",
# type "Web application"). Authorized redirect URIs must be exactly:
#   http://localhost:5173/api/v1/auth/google/callback
#   https://<your-domain>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated front-end origins allowed to start the Google login flow
# (each must exactly match an Authorized redirect URI registered above, minus the path).
GOOGLE_OAUTH_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_ALLOWED_EMAIL_DOMAIN=ictu.edu.vn

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File paths
DSPACE_SNAPSHOT_PATH=./data/snapshots/
SCOPUS_RAW_DIR=./data/raw_scopus/

# Import limits
SCOPUS_IMPORT_MAX_BYTES=20971520
SCOPUS_IMPORT_BATCH_SIZE=100

# M2.6A: Publication normalization
# Number of raw records processed per normalization batch.
# Higher values improve throughput; lower values reduce per-batch memory.
SCOPUS_NORMALIZATION_BATCH_SIZE=500
