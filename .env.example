# Backend configuration (example only — real values MUST NOT be committed)
# Copy to .env and fill locally.

# ----------------------------------------------------------------------
# Database — components only. Compose into DATABASE_URL via app config.
# NEVER embed credentials directly in source or compose files.
# ----------------------------------------------------------------------
DB_DRIVER=postgresql+psycopg2
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=CHANGE_ME

# CORS — comma-separated origins. NEVER hard-code in source.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Security placeholders (M0 — no real JWT logic).
SECRET_KEY=replace_me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment: local | dev | prod
ENVIRONMENT=local

# ICTU snapshot ingestion (offline — file path only)
DSPACE_SNAPSHOT_PATH=./data/snapshots/

# Scopus raw CSV path (offline)
SCOPUS_RAW_DIR=./data/raw_scopus/
