{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopus-ictu.local/schemas/ictu_source_claims.schema.json",
  "title": "ICTU source-claim artifact (contract ictu-source-claims 1.0)",
  "description": "Frozen capture of one ICTU source. `content` is the source assertion and alone defines the content hash; `capture` describes how and when it was observed and never changes that hash. Source claims are not approved identities. Enforced by backend/app/services/source_claims/parser.py; this file documents the same contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "source_system", "capture", "content"],
  "properties": {
    "contract": { "const": "ictu-source-claims" },
    "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+(?![\\s\\S])", "description": "Major 1, numeric minor, nothing after it. The lookahead replaces $, which some validators match before a final newline." },
    "source_system": { "enum": ["ICTU_REPO_SCOPUS_GUIDE", "ICTU_REPO_PROFILES"] },
    "capture": {
      "type": "object",
      "description": "Capture metadata. Free extra fields (tool, operator note, raw HTML hash) are kept but never hashed into content.",
      "required": ["captured_at", "completeness"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time", "description": "ISO-8601 with UTC offset." },
        "completeness": { "enum": ["COMPLETE", "PARTIAL"], "description": "Only COMPLETE captures can prove a claim was withdrawn." },
        "raw_html_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/guideContent" },
        { "$ref": "#/$defs/profilesContent" }
      ]
    }
  },
  "$defs": {
    "cell": {
      "description": "A source cell, verbatim. Floats are not allowed anywhere in an artifact.",
      "type": ["string", "integer", "boolean", "null"]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "role"],
      "properties": {
        "header": { "type": "string", "description": "Column header exactly as published." },
        "role": {
          "enum": ["NAME", "EMAIL", "DECLARED_ID_COUNT", "DECLARED_PUB_COUNT", "PRIMARY_SCOPUS_ID",
                   "SCOPUS_ID_LIST", "SCOPUS_NAME", "SCOPUS_ID", "OTHER"]
        }
      }
    },
    "table": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "heading": { "type": "string" },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } } }
      }
    },
    "guideContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "tables"],
      "properties": {
        "source_url": { "type": "string", "minLength": 1 },
        "page_summary": {
          "type": "object",
          "properties": {
            "text": { "type": ["string", "null"], "description": "Raw summary text as published." },
            "declared_counts": {
              "type": "object",
              "additionalProperties": false,
              "description": "Counts the source itself asserts (e.g. 35 lecturers) — kept even when the detailed table differs.",
              "properties": {
                "MULTI_ID_LECTURERS": { "type": "integer", "minimum": 0 },
                "AMBIGUOUS_IDS": { "type": "integer", "minimum": 0 },
                "UNASSIGNED_IDS": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "tables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "MULTI_ID": { "$ref": "#/$defs/table", "description": "Roles: NAME, EMAIL, DECLARED_ID_COUNT, DECLARED_PUB_COUNT, PRIMARY_SCOPUS_ID, SCOPUS_ID_LIST (required), OTHER." },
            "AMBIGUOUS": { "$ref": "#/$defs/table", "description": "Roles: SCOPUS_NAME, SCOPUS_ID (required), DECLARED_PUB_COUNT, OTHER." },
            "UNASSIGNED": { "$ref": "#/$defs/table", "description": "Roles: SCOPUS_NAME, SCOPUS_ID (required), DECLARED_PUB_COUNT, OTHER." }
          }
        }
      }
    },
    "profilesContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "profiles"],
      "properties": {
        "source_url": { "type": "string", "minLength": 1 },
        "declared_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "PROFILES": { "type": "integer", "minimum": 0 } }
        },
        "profiles": {
          "type": "array",
          "description": "Every profile, including those without publications. Each object is kept verbatim; source_id, email, orcid and full_name have defined meanings.",
          "items": {
            "type": "object",
            "properties": {
              "source_id": { "type": ["string", "null"] },
              "full_name": { "type": ["string", "null"] },
              "email": { "type": ["string", "null"] },
              "orcid": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
