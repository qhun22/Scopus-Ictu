{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopus-ictu.local/schemas/ictu_lecturers.schema.json",
  "title": "ICTU Lecturer Master Dataset",
  "description": "Dataset of ICTU lecturers extracted from https://en.ictu.edu.vn/lecturers. Source-of-truth provenance is preserved under each record's `provenance` block. All fields are nullable unless marked required; null values represent fields the source did not publish (not a fabrication signal).",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "lecturers"],
  "properties": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_version",
        "institution",
        "source",
        "source_url",
        "generated_at",
        "parser_version",
        "record_count"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "institution": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_system": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "parser_version": { "type": "string", "minLength": 1 },
        "record_count": { "type": "integer", "minimum": 0 }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "official_total_declared": { "type": ["integer", "null"], "minimum": 0 },
        "expected_in_directive": { "type": ["integer", "null"], "minimum": 0 },
        "coverage_status": {
          "type": "string",
          "enum": ["FULL", "PARTIAL", "STALE"]
        },
        "coverage_notes": { "type": "string" }
      }
    },
    "lecturers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lecturer" }
    }
  },
  "$defs": {
    "lecturer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "academic_degree",
        "faculty",
        "department",
        "provenance",
        "is_active"
      ],
      "properties": {
        "source_id": {
          "type": ["string", "null"],
          "description": "Stable identifier published by the source system, if any. ICTU does not publish stable IDs on the English page."
        },
        "staff_code": {
          "type": ["string", "null"],
          "description": "Public staff code (MSCB). ICTU does not publish staff codes on the English page; left null.",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Canonical display name. Vietnamese diacritics preserved."
        },
        "institutional_email": {
          "type": ["string", "null"],
          "format": "email",
          "maxLength": 255
        },
        "tel": {
          "type": ["string", "null"],
          "pattern": "^[0-9+()\\-\\s]+$",
          "maxLength": 30
        },
        "academic_degree": {
          "type": ["string", "null"],
          "enum": ["TS", "ThS", "KS", "CN", "PGS", "GS", null],
          "description": "Mapped academic degree: TS=Tiến sĩ, ThS=Thạc sĩ, KS=Kỹ sư, CN=Cử nhân, PGS/GS are senior ranks."
        },
        "academic_rank": {
          "type": ["string", "null"],
          "enum": ["PGS", "GS", null]
        },
        "position": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "faculty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "profile_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "orcid": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
        },
        "is_active": { "type": "boolean" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_name", "source_system", "source_urls"],
          "properties": {
            "source_name": { "type": "string", "minLength": 1 },
            "source_system": { "type": "string", "minLength": 1 },
            "source_urls": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "format": "uri" }
            },
            "source_record_id": { "type": ["string", "null"] },
            "retrieved_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "known_publications": {
          "type": "array",
          "items": { "$ref": "#/$defs/known_publication" }
        }
      }
    },
    "known_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_raw"],
      "properties": {
        "title_raw": { "type": "string", "minLength": 1 },
        "title_normalized": { "type": "string" },
        "doi_raw": { "type": ["string", "null"] },
        "doi_normalized": { "type": ["string", "null"] },
        "source_title_raw": { "type": ["string", "null"] },
        "published_year": {
          "type": ["integer", "null"],
          "minimum": 1000,
          "maximum": 9999
        }
      }
    }
  }
}
